{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMA Campaign",
  "type": "object",
  "required": ["id", "name", "description", "orchestrator", "agents"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
    "name": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "orchestrator": { "$ref": "#/$defs/orchestrator" },
    "agents": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/agent_id" },
      "contains": { "$ref": "#/$defs/orchestrator" },
      "maxContains": 1
    },
    "goals": { "$ref": "#/$defs/text_list" },
    "plans": { "$ref": "#/$defs/text_list" },
    "integrations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/properties/id" }, "description": "Integration IDs declared for workspace setup." },
    "analytics_datasets": {
      "type": "object",
      "description": "Campaign-scoped, read-only dataset contracts for MCP tools with cursor pagination.",
      "propertyNames": { "$ref": "#/properties/id" },
      "additionalProperties": { "$ref": "#/$defs/analytics_dataset" }
    },
    "integration_categories": {
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" },
      "description": "Suggested Composio toolkit category labels for tool discovery. Does not select or connect integrations."
    },
    "mode": { "enum": ["yolo", "approve", "control"], "default": "approve", "description": "Campaign automation and publishing policy; separate from lifecycle." },
    "lifecycle_state": { "enum": ["paused", "pausing", "resumed"], "readOnly": true },
    "kanban_board": { "type": "string", "pattern": "^campaign-[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
    "kanban_board_name": { "$ref": "#/$defs/text" },
    "installation_state": { "enum": [null, "installing", "installed"], "readOnly": true },
    "model": { "type": ["string", "object"], "description": "Native Hermes model shorthand or mapping." },
    "agent": {
      "type": "object", "additionalProperties": false,
      "properties": { "reasoning_effort": { "enum": [null, false, "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] } }
    },
    "mcp_servers": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "type": "object" } },
    "all-keys": { "$ref": "#/$defs/key_names", "readOnly": true },
    "available-keys": { "$ref": "#/$defs/key_names", "readOnly": true },
    "version": { "description": "Legacy template metadata. Not required or authored on new records." },
    "playbook": { "description": "Legacy field; ignored. New records use the singleton playbook." }
  },
  "$defs": {
    "analytics_dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["integration", "server", "tool", "account", "arguments", "items", "record_id"],
      "properties": {
        "integration": { "$ref": "#/properties/id" },
        "server": { "$ref": "#/$defs/analytics_label" },
        "tool": { "$ref": "#/$defs/analytics_label" },
        "account": { "$ref": "#/$defs/analytics_label" },
        "arguments": { "type": "object" },
        "items": { "$ref": "#/$defs/analytics_path" },
        "record_id": { "$ref": "#/$defs/analytics_path" },
        "pagination": {
          "type": "object", "additionalProperties": false, "required": ["parameter"],
          "properties": {
            "kind": { "enum": ["cursor", "offset", "page"], "default": "cursor" },
            "parameter": { "$ref": "#/$defs/analytics_label" },
            "next": { "$ref": "#/$defs/analytics_path" },
            "size_parameter": { "$ref": "#/$defs/analytics_label" }
          },
          "if": { "required": ["kind"], "properties": { "kind": { "enum": ["offset", "page"] } } },
          "then": { "required": ["size_parameter"] },
          "else": { "required": ["next"] }
        }
      }
    },
    "analytics_label": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
    "analytics_path": {
      "type": "string", "maxLength": 512, "pattern": "^[a-zA-Z0-9_-]+(?:[.][a-zA-Z0-9_-]+)*$"
    },
    "text": { "type": "string", "pattern": "\\S" },
    "text_list": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "agent_id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*__[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
    "orchestrator": { "type": "string", "$ref": "#/$defs/agent_id", "pattern": "__orchestrator(?![\\s\\S])" },
    "key_names": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])" }
    }
  }
}
